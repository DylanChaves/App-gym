# Generate a local key. Never use this example as a production secret.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:9000,http://localhost:9000
MYSQL_DATABASE=gym_development
MYSQL_TEST_DATABASE=gym_test
MYSQL_USER=gym_app
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
# Public registration is disabled until actual policies are approved.
REGISTRATION_ENABLED=false
TERMS_VERSION=
PRIVACY_VERSION=
TERMS_URL=
PRIVACY_URL=
