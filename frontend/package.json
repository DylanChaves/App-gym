{
  "name": "gym-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "prepare": "quasar prepare",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "quasar prepare"
  },
  "engines": { "node": ">=22.22.0 <23 || >=24" },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "pinia": "^3.0.3",
    "quasar": "2.34.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@quasar/app-vite": "2.6.2",
    "@types/node": "^22.18.0",
    "@playwright/test": "^1.55.1",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.6",
    "workbox-build": "^7.3.0"
  },
  "overrides": { "esbuild": "^0.28.1" }
